# Your Sonus API key. Needs the `calls:start-web` permission.
# Create it in the dashboard: Settings -> API keys.
# This is a SERVER-side secret — it must never reach the browser, which is the
# whole reason /api/start-call exists.
SONUS_API_KEY=sonus_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The agent to talk to.
SONUS_AGENT_ID=00000000-0000-0000-0000-000000000000

# https://api.sonus.ws for production, https://api-staging.sonus.ws for staging.
SONUS_API_URL=https://api-staging.sonus.ws
